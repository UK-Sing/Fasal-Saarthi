# --- Backend ---
# firestore (default) | sqlite (offline fallback, uses DATABASE_URL)
DATABASE_BACKEND=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
DATABASE_URL=sqlite:///./fasal.db
# DATABASE_URL=postgresql+psycopg://fasal:fasal@localhost:5432/fasal
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep false for a deterministic, offline-safe demo. Flip to true to use live APIs
# (Open-Meteo forecast + rainfall climatology for the water constraint; Agmarknet if a key is set).
USE_LIVE_DATA=false
# Optional. If set, every endpoint except /health requires the header  X-API-Key: <value>
API_KEY=
# Free key from data.gov.in (My Account -> API key) for Agmarknet mandi prices
DATA_GOV_API_KEY=
# Any OpenAI-compatible endpoint (leave empty for template explanations)
#   Ollama: http://localhost:11434/v1  | Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must equal API_KEY above if that is set
NEXT_PUBLIC_API_KEY=
